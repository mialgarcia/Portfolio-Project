"""
Main script for cleaning the raw sales dataset.
This script loads raw data, applies cleaning steps, and outputs a cleaned CSV.
"""


import pandas as pd


# -------------------------------
# Copilot‑assisted function 1
# -------------------------------
# This function loads data from a given file path.
# I used Copilot to generate the initial version, then modified variable
# names and added error handling.
def load_data(file_path: str):
try:
return pd.read_csv(file_path)
except FileNotFoundError:
raise FileNotFoundError(f"File not found: {file_path}")


# -------------------------------
# Copilot‑assisted function 2
# -------------------------------
# This function standardizes column names.
# Copilot suggested using list comprehensions; I modified formatting rules.
def clean_column_names(df):
df.columns = [col.strip().lower().replace(" ", "_") for col in df.columns]
return df


# -------------------------------
# Handle missing values
# -------------------------------
# Remove rows where price or quantity is missing.
def handle_missing_values(df):
df = df.dropna(subset=["price", "quantity"], how="any")
return df


# -------------------------------
# Remove invalid values
# -------------------------------
# Negative prices or quantities indicate data entry mistakes.
def remove_invalid_rows(df):
return df[(df["price"] >= 0) & (df["quantity"] >= 0)]


# -------------------------------
# Main Execution Block
# -------------------------------
if __name__ == "__main__":
raw_path = "data/raw/sales_data_raw.csv"
cleaned_path = "data/processed/sales_data_clean.csv"


df_raw = load_data(raw_path)
df_clean = clean_column_names(df_raw)
df_clean = handle_missing_values(df_clean)
df_clean = remove_invalid_rows(df_clean)


df_clean.to_csv(cleaned_path, index=False)
print("Cleaning complete. First few rows:")
print(df_clean.head())
